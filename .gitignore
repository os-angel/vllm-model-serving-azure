# Terraform: conservar el estado local para destroy, fuera de Git.
.local/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json

# .terraform.lock.hcl sí debe versionarse cuando se implemente Terraform.

# Artefactos locales de Python/UV.
__pycache__/
*.py[cod]
.venv/
